{
  "expo": {
    "name": "Algo-Rhythm Coordinator",
    "slug": "algo-rhythm-coordinator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0724"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0724"
      },
      "package": "com.teamscai.algorhythm.coordinator",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Algo-Rhythm Coordinator to use camera for scanning attendee entry QR tickets."
        }
      ]
    ]
  }
}
